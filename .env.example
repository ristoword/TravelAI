# Environment template for TravelAI
# Copy to `.env` and fill real values. Never commit `.env`.
# I segreti di produzione vivono solo nel pannello Railway — non qui.

# PostgreSQL connection string (required for DB features / auth persistente)
DATABASE_URL=

# Auth.js / NextAuth
# In produzione Railway impostare:
#   NEXTAUTH_URL=https://travelai-production-ceae.up.railway.app
#   AUTH_URL=https://travelai-production-ceae.up.railway.app
#   AUTH_TRUST_HOST=true
#   NEXTAUTH_SECRET= (o AUTH_SECRET) — valore casuale forte, solo su Railway
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Optional OAuth (leave empty = OAuth not configured; no fake login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional email provider (leave empty = email not sent; tokens still persisted)
# EMAIL_SERVER=  # e.g. smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=

# AI assistant (leave empty = chat shows INTEGRAZIONE NON CONFIGURATA — API KEY NECESSARIA)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Payments (leave empty = booking flow stops with stripe_not_configured)
# Checkout browser requires BOTH secret + publishable. Webhook secret verifies signatures.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Amadeus for Developers (sandbox test) ---
# Un solo account OAuth2 client_credentials per voli, hotel e transfer.
# Senza CLIENT_ID + CLIENT_SECRET => provider_not_configured (nessun mock).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Alias legacy (opzionali): API_KEY può coincidere con AMADEUS_CLIENT_ID.
# Il secret resta AMADEUS_CLIENT_SECRET. BASE_URL può sovrascrivere l'host Amadeus.
FLIGHT_PROVIDER_API_KEY=
FLIGHT_PROVIDER_BASE_URL=
HOTEL_PROVIDER_API_KEY=
HOTEL_PROVIDER_BASE_URL=
CAR_PROVIDER_API_KEY=
CAR_PROVIDER_BASE_URL=
# ACTIVITY_PROVIDER_API_KEY=
# ACTIVITY_PROVIDER_BASE_URL=

# Airport autocomplete: dataset pubblico OurAirports (download automatico).
# Opzionale: URL CSV alternativo o path locale già scaricato.
AIRPORT_AUTOCOMPLETE_BASE_URL=
# AIRPORT_AUTOCOMPLETE_API_KEY=
AIRPORT_DATASET_PATH=
